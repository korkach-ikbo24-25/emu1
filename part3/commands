import base64
from vfs import VFS, VFSError
from parser import tokenize, ParseError

class CommandError(Exception):
    pass

class Shell:
    def __init__(self, vfs: VFS):
        self.vfs = vfs
        self.exit_requested = False
        self.commands = {
            'ls':   self.cmd_ls,
            'cd':   self.cmd_cd,
            'pwd':  self.cmd_pwd,
            'cat':  self.cmd_cat,
            'echo': self.cmd_echo,
            'help': self.cmd_help,
            'exit': self.cmd_exit,
        }

    def execute(self, line):
        line = line.strip()
        if not line or line.startswith('#'):
            return ''
        try:
            tokens = tokenize(line)
        except ParseError as e:
            return f"parse error: {e}"
        if not tokens:
            return ''
        cmd, args = tokens[0], tokens[1:]
        fn = self.commands.get(cmd)
        if not fn:
            return f"{cmd}: команда не найдена"
        try:
            return fn(args)
        except (CommandError, VFSError) as e:
            return f"{cmd}: {e}"
        except Exception as e:
            return f"{cmd}: внутренняя ошибка: {e}"

    def cmd_ls(self, args):
        path = args[0] if args else self.vfs.getcwd()
        items = self.vfs.listdir(path)
        return '\n'.join(items) if items else ''

    def cmd_cd(self, args):
        if not args:
            self.vfs.chdir('/')
        else:
            self.vfs.chdir(args[0])
        return ''

    def cmd_pwd(self, args):
        return self.vfs.getcwd()

    def cmd_echo(self, args):
        return ' '.join(args)

    def cmd_cat(self, args):
        if not args:
            raise CommandError("укажите файл")
        out = []
        for f in args:
            data = self.vfs.read_file(f)
            try:
                out.append(data.decode('utf-8'))
            except UnicodeDecodeError:
                out.append(base64.b64encode(data).decode('ascii'))
        return '\n'.join(out)

    def cmd_help(self, args):
        return "Доступно: " + ', '.join(sorted(self.commands))

    def cmd_exit(self, args):
        self.exit_requested = True
        return "Завершение работы..."
